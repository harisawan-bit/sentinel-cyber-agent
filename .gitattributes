# Normalise line endings.
* text=auto eol=lf

# Keep C, shell, and Makefile out of diff noise on Windows checkouts.
*.c   text eol=lf
*.h   text eol=lf
*.sh  text eol=lf
Makefile text eol=lf

# Generated reports are build output, not hand-written source. Excluding them
# keeps the language breakdown honest.
*.html linguist-generated=true
